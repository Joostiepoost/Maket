                }
            },
            {
                "box": {
                    "id": "obj-c2",
                    "linecount": 3,
                    "maxclass": "comment",
                    "numinlets": 1,
                    "numoutlets": 0,
                    "patching_rect": [ 30.0, 48.0, 640.0, 47.0 ],
                    "text": "Notes when each message arrives in Max: every message gets a number and the time on the computer's clock, in milliseconds since the last reset, and is kept in the coll below. Maket's test pages reset the log and have it written by themselves."
                }
            },
            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
